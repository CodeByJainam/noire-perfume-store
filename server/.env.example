# Copy this file to .env and fill in real values locally.
# MongoDB Atlas -> Connect -> Drivers
MONGO_URI=mongodb+srv://DB_USERNAME:URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/noire?retryWrites=true&w=majority
PORT=5000
# Comma-separated frontend origins are supported.
CLIENT_URL=http://localhost:5173

# Required for login/session JWT signing. Use a long random secret.
AUTH_JWT_SECRET=replace_with_a_long_random_secret

# Razorpay Dashboard -> Test Mode -> API Keys
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me_with_your_test_secret

# Optional. Configure this only if you create a Razorpay webhook.
RAZORPAY_WEBHOOK_SECRET=

# Email address of the one store administrator. Create a normal account with this email,
# then log in; the server will promote that account to admin. Never expose this in frontend env.
ADMIN_EMAIL=admin@example.com
