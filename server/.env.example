# Copy this file to server/.env and fill in your own values.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
AUTH_JWT_SECRET=replace_with_a_long_random_secret
CLIENT_URL=http://localhost:5173
PORT=5000

# Local-only simulated checkout: set to demo to test success/failure without Razorpay or PAN.
# Never enable demo mode in production. Use razorpay when you have Razorpay Test API keys.
PAYMENT_MODE=demo
ALLOW_DEMO_PAYMENTS=true

# Razorpay TEST MODE credentials only (Key ID must start with rzp_test_).
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
# Optional: configure only if you create a Razorpay webhook for local/dev testing.
RAZORPAY_WEBHOOK_SECRET=
